<?xml version="1.0" encoding="UTF-8"?>
<!--
  Common module — shared DTOs, ApiResponse<T>, BaseController, filters, handlers.
  No Spring Boot plugin (NOT a runnable app). Pure library jar.
  -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tapstate</groupId>
    <artifactId>tapstate-cloud-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tapstate-cloud-common</artifactId>
  <packaging>jar</packaging>
  <name>Tapstate Cloud Common</name>

  <dependencies>
    <!-- spring-web for ResponseEntity + filter classes (NOT full spring-boot-starter-web) -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
    </dependency>
    <!-- Jackson for @JsonInclude -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <!-- Swagger annotations for shared DTOs (version aligned with springdoc 2.8.8 → swagger 2.2.30) -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
      <version>2.2.30</version>
    </dependency>
    <!-- Jakarta servlet for OncePerRequestFilter -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- slf4j-api for @Slf4j annotation -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>
</project>
