<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tapstate Cloud Control Plane — Java SDK module.
  Auto-generated by openapi-generator-maven-plugin from the running control
  plane's /v3/api-docs. Run `mvn generate-sources` AFTER the control plane
  is up (defaults to http://localhost:8080; override with -Dapi.base.url).

  The generator writes into this module's root (src/main/java/, src/test/, etc.)
  but will NOT overwrite pom.xml or other project-owned files — those are
  protected by .openapi-generator-ignore. Generated scaffold files (README.md,
  build.gradle, gradlew, ...) land in .gitignore and are not committed.
  -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tapstate</groupId>
    <artifactId>tapstate-cloud-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>cloud-control-plane-sdk</artifactId>
  <packaging>jar</packaging>
  <name>Tapstate Cloud Control Plane SDK</name>

  <properties>
    <!-- Live Control Plane base URL — override with -Dapi.base.url=http://other:9090 -->
    <api.base.url>http://localhost:8080</api.base.url>
    <!-- Local OpenAPI spec path (also checked-in source of truth; overwritten on live download success) -->
    <openapi.input.spec>${project.basedir}/../api/openapi.yaml</openapi.input.spec>
    <maven.test.skip>true</maven.test.skip>
  </properties>

  <dependencies>
    <!-- Jakarta annotations — generated SDK uses @Nullable etc. (Jakarta 10.x) -->
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>

    <!-- Jackson — SDK deserializes JSON via jackson databind + annotations -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <!-- Apache HttpClient 5 -->
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
    </dependency>

    <!-- SLF4J -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- JJWT — offline JWKS JWT verification (parent pom manages jjwt.version=0.12.6) -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Test dependencies — plain Java library, no Spring Boot -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Exclude broken auto-generated API/model tests from compilation — these are
           scaffold drift from openapi-generator and never meant to compile. Our hand-written
           facade tests in src/test/java/io/tapstate/cloud/sdk/client/ cover the real code. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <testExcludes>
            <testExclude>io/tapstate/cloud/sdk/api/*Test.java</testExclude>
            <testExclude>io/tapstate/cloud/sdk/model/*Test.java</testExclude>
          </testExcludes>
        </configuration>
      </plugin>
      <!-- Auto-download live OpenAPI spec from running Control Plane before SDK codegen.
           Silently falls back to the checked-in openapi.yaml when server is unreachable.
           Override URL: -Dapi.base.url=http://other:9090 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>download-live-openapi</id>
            <phase>validate</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <exec executable="sh" failifexecutionfails="false">
                  <arg value="-c" />
                  <arg value="curl -sf -o ${openapi.input.spec} ${api.base.url}/v3/api-docs.yaml &amp;&amp; echo '[openapi-download] OK Downloaded spec from ${api.base.url}/v3/api-docs.yaml' || echo '[openapi-download] WARN Live spec unavailable at ${api.base.url} -- using checked-in openapi.yaml'" />
                </exec>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Generate Java SDK from the running control plane's OpenAPI spec -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-java-client</id>
            <phase>generate-sources</phase>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${openapi.input.spec}</inputSpec>
              <generatorName>java</generatorName>
              <output>${project.basedir}</output>
              <!-- NO cleanup — .openapi-generator-ignore protects pom.xml etc. -->
              <cleanupOutput>false</cleanupOutput>
              <packageName>io.tapstate.cloud.sdk</packageName>
              <validateSpec>false</validateSpec>
              <skip>${skipSdkGeneration}</skip>
              <configOptions>
                <library>apache-httpclient</library>
                <basePackage>io.tapstate.cloud.sdk</basePackage>
                <apiPackage>io.tapstate.cloud.sdk.api</apiPackage>
                <modelPackage>io.tapstate.cloud.sdk.model</modelPackage>
                <serializationLibrary>jackson</serializationLibrary>
                <booleanGetterPrefix>is</booleanGetterPrefix>
                <dateLibrary>java21</dateLibrary>
                <openApiNullable>false</openApiNullable>
                <useJakartaEe>true</useJakartaEe>
                <generateApiTests>false</generateApiTests>
                <generateModelTests>false</generateModelTests>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
